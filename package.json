{
  "name": "just-book-reader",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A simple book gallery for Obsidian.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build --config vite.plugin.config.ts && node scripts/licenses.mjs && node scripts/package.mjs",
    "build:dev": "vite build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-i18n": "11.4.14"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "obsidian": "1.14.4",
    "sass": "1.105.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.13"
  }
}
